{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/scripts/post-edit-typecheck.js" },
          { "type": "command", "command": "node .claude/hooks/scripts/check-console-log.js" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/scripts/block-no-verify.js" },
          { "type": "command", "command": "node .claude/hooks/scripts/quality-gate.js" }
        ]
      }
    ]
  }
}
